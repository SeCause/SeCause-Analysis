DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/secause
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TIMEOUT_SECONDS=30
CLAUDE_MAX_OUTPUT_TOKENS=1200
CLAUDE_MAX_RETRIES=2
LLM_EVIDENCE_TOP_K=5
LLM_MAX_EVIDENCE_CHARS=1200
LLM_MAX_TOTAL_EVIDENCE_CHARS=6000
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
RAG_VECTOR_TOP_K=10
RAG_FTS_TOP_K=10
RAG_RESULT_TOP_K=5
RAG_RRF_K=60
REDIS_URL=redis://localhost:6379/0
ANALYSIS_QUEUE_NAME=analysis
GITHUB_TOKEN_TTL_SECONDS=3600
SPRING_CALLBACK_BASE_URL=http://localhost:8080
SPRING_SUCCESS_CALLBACK_PATH=/internal/analysis/callback/success
SPRING_FAILURE_CALLBACK_PATH=/internal/analysis/callback/failure
SPRING_CALLBACK_TIMEOUT_SECONDS=10
SPRING_CALLBACK_MAX_RETRIES=2
GIT_CLONE_ROOT_DIR=/tmp/secause-analysis
GIT_CLONE_TIMEOUT_SECONDS=120
HOST=0.0.0.0
PORT=8001
DEBUG=false
