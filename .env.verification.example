# Copy to .env.verification, or provide these via process/container environment.
# Do not add VERIFICATION_* keys to .env: the analysis Settings rejects extra dotenv keys.
# Shared CLAUDE_API_KEY, REDIS_URL and ANALYSIS_CALLBACK_INTERNAL_TOKEN can stay in .env.
VERIFICATION_MODEL=claude-sonnet-4-6
VERIFICATION_LLM_TIMEOUT_SECONDS=45
VERIFICATION_LLM_MAX_RETRIES=1
VERIFICATION_MAX_OUTPUT_TOKENS=8000
VERIFICATION_JOB_TIMEOUT_SECONDS=360
VERIFICATION_QUEUE_TTL_SECONDS=600
VERIFICATION_RESULT_TTL_SECONDS=3600
VERIFICATION_FAILURE_TTL_SECONDS=3600
